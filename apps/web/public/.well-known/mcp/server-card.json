{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.jpamorgan.art/catalog",
  "title": "Art by John Philip Morgan",
  "description": "Browse curated physical art with filters and an interactive MCP Apps gallery.",
  "version": "1.0.0",
  "websiteUrl": "https://art.jpamorgan.com/",
  "repository": {
    "url": "https://github.com/jpamorgan/art-curator",
    "source": "github",
    "subfolder": "apps/server"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.art.jpamorgan.com/mcp"
    }
  ],
  "capabilities": {
    "tools": true,
    "resources": true,
    "extensions": {
      "io.modelcontextprotocol/ui": {
        "mimeTypes": ["text/html;profile=mcp-app"]
      }
    }
  }
}
